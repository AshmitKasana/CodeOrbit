# Frontend flag: when "true", aiService.js calls the backend at /api/generate
# instead of using the local mock generator. The backend (server/index.js) is
# where the real API key is used — it is never read from frontend code.
VITE_USE_REAL_AI=false

# Backend only (used by server/index.js, never imported by the frontend bundle).
# Put your provider key here and keep this file out of version control.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
PORT=8787
