# --- Supabase Auth (frontend-safe) -----------------------------------------
# From your Supabase project: Settings -> API. The anon key is public by
# design (safe to ship in the frontend bundle) — it only grants what your
# Row Level Security policies allow. NEVER put the service_role key here.
# See AUTH_SETUP.md for full setup instructions (Google, Apple, database).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: base URL of a separate deployed API, if you have one beyond the
# bundled server/index.js. Leave blank to use same-origin /api/* requests.
VITE_API_URL=

# --- AI generation ------------------------------------------------------
# When "true", aiService.js calls the backend at /api/generate instead of
# using the local mock generator. The backend (server/index.js) is where the
# real API key is used — it is never read from frontend code.
VITE_USE_REAL_AI=false

# Backend only (used by server/index.js, never imported by the frontend bundle).
# Put your provider key here and keep this file out of version control.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
PORT=8787
