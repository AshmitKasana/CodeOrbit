# Copy this file to `.env` (never commit `.env`). Everything here is optional:
# with no configuration the app runs fully offline on its built-in content.

# --- Supabase Auth (frontend-safe) -----------------------------------------
# From your Supabase project: Settings -> API. The anon key is public by
# design (safe to ship in the frontend bundle) — it only grants what your
# Row Level Security policies allow. NEVER put the service_role key here.
# See AUTH_SETUP.md for full setup instructions (Google, Apple, database).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI lessons (frontend switch) ---------------------------------------
# "true" makes the frontend call the backend (server/index.js) for real AI
# lessons. If the backend is down or has no key, it quietly falls back to the
# built-in content, so this is safe to leave on.
VITE_USE_REAL_AI=false

# Base URL of the deployed backend, e.g. https://code-orbit-api.onrender.com
# Leave blank to use same-origin /api/* (Vite proxies it to localhost:8787 in dev).
VITE_API_URL=

# =========================================================================
# Backend only (read by server/index.js, never bundled into the frontend)
# =========================================================================

# Enables real AI. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Any Claude model id. claude-opus-5 is the default; claude-sonnet-5 or
# claude-haiku-4-5 are cheaper/faster options.
ANTHROPIC_MODEL=claude-opus-5
# Reasoning effort: low | medium | high | xhigh | max ("low" keeps lessons fast)
AI_EFFORT=low

PORT=8787

# Origins allowed to call the API from a browser, comma-separated (or "*").
# Needed when the frontend and backend are on different domains,
# e.g. CORS_ORIGIN=https://codeorbit21.netlify.app
CORS_ORIGIN=

# Set to 1 when the server sits behind a reverse proxy / load balancer
# (Render, Railway, Fly, nginx...) so per-visitor limits use the real client IP.
TRUST_PROXY=

# --- Daily AI allowance (per visitor / per account, resets midnight UTC) ---
QUOTA_GENERATE_ANON=5
QUOTA_GENERATE_USER=25
QUOTA_CHAT_ANON=10
QUOTA_CHAT_USER=50

# Optional: durable, shared quotas + verification of signed-in users.
# Run supabase/ai_usage.sql once, then add the SERVICE ROLE key
# (Supabase -> Settings -> API). It bypasses Row Level Security: keep it
# server-side only, NEVER prefix it with VITE_, NEVER commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional salt used when hashing anonymous visitors' IPs for quota keys.
QUOTA_HASH_SALT=
